<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for the app -->
    <style name="Theme.KreedaPrerana" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.KreedaPrerana.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFF6D00</item>
        <item name="postSplashScreenTheme">@style/Theme.KreedaPrerana</item>
    </style>
</resources>
